---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/rent-indexer/" title="Rent indexation calculator with the official indices" width="100%" height="1100" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the rent indexation calculator – Rent Indexer" description="Copy the code and add the rent indexation calculator for France, Belgium, Spain, Italy, Portugal and Austria to your site. Free, with a visible link back." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the rent indexation calculator</h1>
    <p class="mt-3 text-lg text-navy-700">Copy the code and paste it into your page. The indices are refreshed on our side whenever a statistics office publishes a new figure.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the link under the calculator stays visible, the calculator is not altered, and it comes with no warranty. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/rent-indexer/" title="Rent indexation calculator" width="100%" height="1100" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
