---
/** Pages de contenu (es) : une fiche de src/content/pages.ts + un texte src/content/es/<id>.ts. */
import ContentPage from '../../components/ContentPage.astro';
import { PAGES } from '../../lib/pages';
import type { PageDef } from '../../lib/types';
export function getStaticPaths() { return PAGES.filter((p) => p.texts.es).map((page) => ({ params: { slug: page.texts.es!.slug || undefined }, props: { page } })); }
const { page } = Astro.props as { page: PageDef };
---
<ContentPage page={page} lang="es" />
