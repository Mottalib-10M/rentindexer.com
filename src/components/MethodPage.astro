---
/** Méthode et sources (page de confiance, RECETTE §8.2). Texte : content/<langue>/_site.ts. */
import PageLayout from '../layouts/PageLayout.astro';
import { route, type Locale } from '../i18n/routes';
import { siteText } from '../lib/pages';
import { helpers } from '../lib/helpers';
import { t } from '../i18n/ui';
import { SOURCES, sourceLabel, type SourceKey } from '../data/sources';
import { breadcrumbSchema, webPageSchema, faqSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const H = helpers(lang);
const x = siteText(lang).method;
const path = route('method', lang);
const faqs = x.faqs(H);
const sources = (Object.keys(SOURCES) as SourceKey[]).map((k) => ({ name: sourceLabel(k, lang), url: SOURCES[k].url }));
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={[webPageSchema({ name: x.h1, description: x.description, path, lang }), breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: x.h1, path }]), faqSchema(faqs, lang)]} faqs={faqs} sources={sources} breadcrumbs={[{ label: x.h1 }]}>
  <header class="mb-6"><h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{x.h1}</h1></header>
  <div class="prose prose-slate max-w-none"><Fragment set:html={x.body(H)} /></div>
</PageLayout>
