---
/** Page pour iframe : le calculateur des six pays sans navigation. noindex, hors sitemap (astro.config). */
import '../../styles/global.css';
import HubCalc from '../../components/calc/HubCalc';
import { SITE_URL } from '../../data/site-config';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rent indexation calculator – Rent Indexer</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <HubCalc client:load lang="en" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">Rent Indexer · official indices of France, Belgium, Spain, Italy, Portugal and Austria</a></p>
  </body>
</html>
